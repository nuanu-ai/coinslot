{
  "name": "coinslot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:decisions": "./scripts/check-decisions.sh",
    "db:migrate": "pnpm --filter @coinslot/gateway db:migrate && pnpm --filter @coinslot/cabinet db:migrate",
    "worktrees": "./scripts/worktrees.sh list",
    "worktrees:clean": "./scripts/worktrees.sh clean",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "smoke": "pnpm --filter @coinslot/slice run smoke",
    "smoke:listing": "pnpm --filter @coinslot/gateway run listing",
    "smoke:bootstrap": "pnpm --filter @coinslot/slice run bootstrap",
    "outside": "./scripts/outside.sh",
    "buy": "pnpm --filter @coinslot/slice run buy",
    "stand": "pnpm --filter @coinslot/slice run stand",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.3.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
