#!/usr/bin/env bash
#
# Проверка сообщения коммита на формат Conventional Commits.
#
# Зачем этот файл существует. Пока репозиторий состоял из документов, префикс
# коммита был вежливостью: историю читали глазами, и забытый `docs:` ничего не
# ломал. С появлением кода история становится инструментом — по типу коммита
# работают `git bisect`, changesets и разбор релиза, и они читают строку
# машиной, которой всё равно, что имелось в виду. Хартия называет порог
# перевода правила в машину, а `docs/research/15-culture-stack-position.md`
# заранее назвал этот хук частью стартового машинного минимума.
#
# Почему bash, а не husky с commitlint. Проверка помещается в двадцать строк.
# Husky и commitlint — это две зависимости, свой конфиг и слой между git и
# проверкой; слой окупается, когда правил много, и не окупается на одном.
#
# Как подключается. `pnpm install` выставляет core.hooksPath на .githooks
# (скрипт prepare в корневом package.json). Разовый обход — `git commit
# --no-verify`: это осознанный шаг конкретного коммита, а не настройка.

set -euo pipefail

message_file="$1"

# Первая содержательная строка: комментарии git и пустые строки пропускаем.
subject="$(awk '/^#/ { next } /^[[:space:]]*$/ { next } { print; exit }' "$message_file")"

# Служебные сообщения git пишет сам, и переписывать их не нам.
case "$subject" in
  "Merge "* | "Revert "* | "fixup!"* | "squash!"* | "amend!"*) exit 0 ;;
esac

types='feat|fix|docs|chore|spike|refactor|perf|test|build|ci|style|revert'

if printf '%s' "$subject" | grep -Eq "^(${types})(\([a-z0-9._/-]+\))?!?: .+"; then
  exit 0
fi

cat >&2 <<MESSAGE
Сообщение коммита не в формате Conventional Commits.

  получено: ${subject}
  ожидается: тип(область)!: тема

Тип — один из: ${types//|/, }.
Область необязательна и пишется латиницей в нижнем регистре; тема пишется
по-русски. Восклицательный знак перед двоеточием помечает ломающее изменение.

  docs: план до пилота — четыре этапа ходячего скелета
  feat(contracts): схема карточки товара
  fix(gateway)!: цена в заказе больше не берётся из карточки

Если формат нарушен осознанно, коммит проходит с --no-verify.
MESSAGE

exit 1
