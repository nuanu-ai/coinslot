#!/usr/bin/env bash
#
# Checks the commit message against the Conventional Commits format.
#
# Why this file exists. While the repository consisted of documents, the commit
# prefix was a courtesy: the history was read by eye, and a forgotten `docs:`
# broke nothing. Once there is code, the history becomes a tool — `git bisect`,
# changesets and the release breakdown work off the commit type, and they read
# the line by machine, which does not care what was meant. The charter names
# the threshold for moving a rule into a machine, and
# `docs/research/15-culture-stack-position.md` named this hook in advance as
# part of the starting machine minimum.
#
# Why bash and not husky with commitlint. The check fits into twenty lines.
# Husky and commitlint are two dependencies, a config of their own and a layer
# between git and the check; the layer pays off when there are many rules and
# does not pay off on one.
#
# How it is wired up. `pnpm install` points core.hooksPath at .githooks (the
# prepare script in the root package.json). A one-off bypass is `git commit
# --no-verify`: a deliberate step for one specific commit, not a setting.

set -euo pipefail

message_file="$1"

# The first meaningful line: git comments and blank lines are skipped.
subject="$(awk '/^#/ { next } /^[[:space:]]*$/ { next } { print; exit }' "$message_file")"

# Git writes its housekeeping messages itself, and rewriting them is not ours.
case "$subject" in
  "Merge "* | "Revert "* | "fixup!"* | "squash!"* | "amend!"*) exit 0 ;;
esac

types='feat|fix|docs|chore|spike|refactor|perf|test|build|ci|style|revert'

if printf '%s' "$subject" | grep -Eq "^(${types})(\([a-z0-9._/-]+\))?!?: .+"; then
  exit 0
fi

cat >&2 <<MESSAGE
The commit message is not in the Conventional Commits format.

  got:      ${subject}
  expected: type(scope)!: subject

The type is one of: ${types//|/, }.
The scope is optional and is written in lowercase latin; the subject is
written in English. An exclamation mark before the colon marks a breaking
change.

  docs: plan up to the pilot — four stages of the walking skeleton
  feat(contracts): product card schema
  fix(gateway)!: the order price is no longer taken from the card

If the format is broken deliberately, the commit goes through with --no-verify.
MESSAGE

exit 1
