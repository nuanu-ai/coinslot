{
  "name": "@coinslot/sdk",
  "version": "0.0.0",
  "type": "module",
  "description": "Coinslot merchant SDK — the fulfillment worker and the integration check",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuanu-ai/coinslot.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "bin": {
      "coinslot": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@coinslot/contracts": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
