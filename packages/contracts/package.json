{
  "name": "@coinslot/contracts",
  "version": "0.0.0",
  "type": "module",
  "description": "Coinslot public contract schemas — card, order, price hook, receipt",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuanu-ai/coinslot.git",
    "directory": "packages/contracts"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
