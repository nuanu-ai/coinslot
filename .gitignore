# OS
.DS_Store

# Editors
.idea/
.vscode/
*.swp

# Claude Code — local settings, agent working copies and the design notes a
# session writes for itself are not committed. A spec under docs/superpowers is
# scaffolding for one piece of work: what it decides belongs in docs/decisions,
# and what it explores belongs in docs/research.
.claude/settings.local.json
.claude/worktrees/
docs/superpowers/

# Secrets and environment
.env
.env.*

# Build and dependencies
node_modules/
dist/
coverage/
*.tsbuildinfo

# pnpm keeps a content-addressed store here when a build fetches into the
# repository rather than into the user store. It is a cache, not a source.
.pnpm-store/
