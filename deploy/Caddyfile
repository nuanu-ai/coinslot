# The one door.
#
# ADR-0005 §1: locally, Caddy is the only address anybody types. `/` is the
# landing, `/docs` the portal, `/cabinet` the cabinet and `/v0/*` the gateway,
# so a merchant's engineer sees one origin and never reasons about ports. The
# same file describes the server later, which is why nothing below is written
# twice: every address the routes depend on is one environment variable with a
# local default, and the deployment overrides the variable rather than editing
# a copy of this file.
#
#   COINSLOT_SITE_ADDRESS      what Caddy listens on              :8080
#   COINSLOT_LANDING_ROOT      the landing's static directory     /srv/landing
#   COINSLOT_PORTAL_ROOT       the portal's built output          /srv/docs
#   COINSLOT_CABINET_UPSTREAM  host:port of the cabinet process   cabinet:3001
#   COINSLOT_GATEWAY_UPSTREAM  host:port of the gateway process   gateway:3000
#
# The defaults are the container's view of the world, because ADR-0005 §7 makes
# `docker compose up` how this runs. From a checkout, outside Docker, the same
# file works with the roots pointed at the repository:
#
#   COINSLOT_LANDING_ROOT=apps/landing/public \
#   COINSLOT_PORTAL_ROOT=portal/.vitepress/dist \
#   COINSLOT_CABINET_UPSTREAM=127.0.0.1:3001 \
#   COINSLOT_GATEWAY_UPSTREAM=127.0.0.1:3000 \
#     caddy run --config deploy/Caddyfile
#
# The listen address defaults to a high port rather than :80 so that the same
# line works unprivileged on a laptop and inside a container. A deployment sets
# COINSLOT_SITE_ADDRESS to its hostname, and Caddy's automatic HTTPS turns
# itself on because the address stops being a bare port — which is the reason
# this file does not disable it.

{$COINSLOT_SITE_ADDRESS::8080} {
	encode zstd gzip

	# The gateway. The contract's own route table is written under /v0
	# (packages/contracts/src/api.ts), so the prefix is the gateway's, not a
	# mount point invented here: the path is passed through untouched and the
	# process behind it sees exactly the URL the agent asked for.
	#
	# The gateway must be started with PUBLIC_BASE_URL set to this origin. It
	# puts that address into the payment challenge it sends an agent, and an
	# agent that is told to come back to the process's own port would be sent
	# at a door that is closed from outside.
	handle /v0/* {
		reverse_proxy {$COINSLOT_GATEWAY_UPSTREAM:gateway:3000}
	}

	# The cabinet, its own process rather than part of the gateway (ADR-0005
	# §2). The prefix is passed through rather than stripped, deliberately: the
	# cabinet then reads its own mount point off the request it is answering
	# and builds its links from the same string, instead of being told the
	# prefix out of band and having to prepend it to every href. So the cabinet
	# routes on /cabinet, /cabinet/orders, /cabinet/receipts as written.
	#
	# The prefix is spelled as two exact paths rather than one /cabinet* glob so
	# that it claims the cabinet and its pages and nothing else: a landing page
	# at /cabinets-we-have-known would otherwise disappear into the proxy.
	@cabinet path /cabinet /cabinet/*
	handle @cabinet {
		reverse_proxy {$COINSLOT_CABINET_UPSTREAM:cabinet:3001}
	}

	# The portal. Here the prefix IS stripped, because the other side is a
	# directory of files and not a process: /docs/money has to become money.html
	# on disk.
	#
	# That cuts both ways. The built HTML asks for its stylesheets by absolute
	# path and links its own pages the same way, so the portal has to be built
	# knowing where it lives:
	#
	#   pnpm --dir portal exec vitepress build --base /docs/
	#
	# Built without that flag, every page comes out asking for /assets/... at
	# the root of the origin, where the landing answers and has nothing by that
	# name, and every link in the sidebar points outside /docs. The flag is a
	# build argument rather than an edit to the portal's config on purpose: the
	# mount point is this file's business, and the portal should not have to
	# know it in a file of its own.
	redir /docs /docs/
	handle_path /docs/* {
		root * {$COINSLOT_PORTAL_ROOT:/srv/docs}

		# cleanUrls is on in the portal's config, so /docs/money is a request
		# for a page whose file carries the extension.
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# Everything else is the landing: static files, no runtime behind them
	# (ADR-0005 §5). This block is last and matches everything, so a path that
	# no route above claimed lands on the landing's 404 rather than nowhere.
	handle {
		root * {$COINSLOT_LANDING_ROOT:/srv/landing}
		file_server
	}
}
